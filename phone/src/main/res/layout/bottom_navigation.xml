<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@color/surface"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">

    <ImageButton
        android:id="@+id/nav_player"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_navigation_item_background"
        android:contentDescription="@string/nav_player"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nav_player"
        android:tint="@color/bottom_navigation_icon" />

    <ImageButton
        android:id="@+id/nav_library"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_navigation_item_background"
        android:contentDescription="@string/nav_library"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nav_library"
        android:tint="@color/bottom_navigation_icon" />

    <ImageButton
        android:id="@+id/nav_search"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_navigation_item_background"
        android:contentDescription="@string/nav_search"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nav_search"
        android:tint="@color/bottom_navigation_icon" />

    <ImageButton
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bottom_navigation_item_background"
        android:contentDescription="@string/nav_settings"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nav_settings"
        android:tint="@color/bottom_navigation_icon" />
</LinearLayout>
