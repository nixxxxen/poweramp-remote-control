<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_padding"
    android:paddingTop="6dp"
    android:paddingRight="@dimen/screen_padding"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageButton
            android:id="@+id/player_devices_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/player_devices"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_devices" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/album_art_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp"
        android:background="@drawable/album_art_background">

        <ImageView
            android:id="@+id/album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/album_art_description"
            android:padding="@dimen/album_placeholder_padding"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_album_placeholder" />
    </FrameLayout>

    <TextView
        android:id="@+id/track_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/waiting_title"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/track_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/waiting_artist"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/track_album"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/waiting_album"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:id="@+id/metadata_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/codec_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/chip_green_background"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bit_depth_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_blue_background"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sample_rate_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_violet_background"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bitrate_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_amber_background"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/source_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/track_seek"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="3dp"
        android:max="1"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:progress="0"
        android:progressDrawable="@drawable/music_seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/music_seek_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/elapsed_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/elapsed_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/duration_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/volume_panel"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_volume" />

        <SeekBar
            android:id="@+id/volume_seek"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/remote_volume_description"
            android:max="1"
            android:progress="0"
            android:progressDrawable="@drawable/volume_progress"
            android:splitTrack="false"
            android:thumb="@drawable/volume_thumb" />

        <TextView
            android:id="@+id/volume_value"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="@string/volume_value_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/transport_primary_size"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/previous_button"
            android:layout_width="@dimen/transport_button_size"
            android:layout_height="@dimen/transport_button_size"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/previous_track"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_previous"
            android:tint="@color/control_icon" />

        <Space android:layout_width="18dp" android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/play_pause_button"
            android:layout_width="@dimen/transport_primary_size"
            android:layout_height="@dimen/transport_primary_size"
            android:background="@drawable/control_primary_background"
            android:contentDescription="@string/play"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="20dp"
            android:src="@drawable/ic_play"
            android:tint="@color/primary_icon" />

        <Space android:layout_width="18dp" android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/next_button"
            android:layout_width="@dimen/transport_button_size"
            android:layout_height="@dimen/transport_button_size"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/next_track"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_next"
            android:tint="@color/control_icon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/secondary_button_size"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/dislike_button"
            android:layout_width="@dimen/secondary_button_size"
            android:layout_height="@dimen/secondary_button_size"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/dislike"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_thumb_down"
            android:tint="@color/control_icon" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/rating_button"
            android:layout_width="68dp"
            android:layout_height="@dimen/secondary_button_size"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/rating_change"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:text="@string/rating_unknown"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/like_button"
            android:layout_width="@dimen/secondary_button_size"
            android:layout_height="@dimen/secondary_button_size"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/like"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_thumb_up"
            android:tint="@color/control_icon" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/shuffle_button"
            android:layout_width="@dimen/secondary_button_size"
            android:layout_height="@dimen/secondary_button_size"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/shuffle_enable"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/control_icon" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/error"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
