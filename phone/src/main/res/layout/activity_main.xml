<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="18dp"
        android:paddingRight="@dimen/screen_padding"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/status_background"
            android:paddingLeft="14dp"
            android:paddingTop="9dp"
            android:paddingRight="14dp"
            android:paddingBottom="9dp"
            android:text="@string/status_searching"
            android:textColor="@color/warning"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/server_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/pairing_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="18dp">

            <ProgressBar
                android:id="@+id/discovery_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/pairing_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pairing_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="@string/pairing_scanning"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/found_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/token_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/accent"
                android:hint="@string/token_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:maxLength="64"
                android:maxLines="1"
                android:minHeight="52dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/pair_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/action_button_background"
                android:enabled="false"
                android:minHeight="50dp"
                android:text="@string/pair_button"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/album_art"
                android:layout_width="@dimen/album_art_size"
                android:layout_height="@dimen/album_art_size"
                android:background="@drawable/album_art_background"
                android:contentDescription="@string/album_art_description"
                android:padding="38dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_album_placeholder" />

            <TextView
                android:id="@+id/track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/waiting_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/waiting_artist"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/track_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/waiting_album"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/audio_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/source_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/track_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="1"
                android:progress="0"
                android:progressBackgroundTint="@color/surface_high"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/elapsed_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="@string/elapsed_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/duration_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/duration_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/previous_button"
                    android:layout_width="@dimen/transport_button_size"
                    android:layout_height="@dimen/transport_button_size"
                    android:background="@drawable/control_button_background"
                    android:contentDescription="@string/previous_track"
                    android:padding="16dp"
                    android:src="@drawable/ic_previous"
                    android:tint="@color/control_icon" />

                <Space android:layout_width="14dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/play_pause_button"
                    android:layout_width="@dimen/transport_primary_size"
                    android:layout_height="@dimen/transport_primary_size"
                    android:background="@drawable/control_primary_background"
                    android:contentDescription="@string/play"
                    android:padding="18dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/primary_icon" />

                <Space android:layout_width="14dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/next_button"
                    android:layout_width="@dimen/transport_button_size"
                    android:layout_height="@dimen/transport_button_size"
                    android:background="@drawable/control_button_background"
                    android:contentDescription="@string/next_track"
                    android:padding="16dp"
                    android:src="@drawable/ic_next"
                    android:tint="@color/control_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/dislike_button"
                    android:layout_width="@dimen/secondary_button_size"
                    android:layout_height="@dimen/secondary_button_size"
                    android:background="@drawable/control_button_background"
                    android:contentDescription="@string/dislike"
                    android:padding="13dp"
                    android:src="@drawable/ic_thumb_down"
                    android:tint="@color/control_icon" />

                <Space android:layout_width="9dp" android:layout_height="1dp" />

                <Button
                    android:id="@+id/rating_button"
                    android:layout_width="76dp"
                    android:layout_height="@dimen/secondary_button_size"
                    android:background="@drawable/control_button_background"
                    android:contentDescription="@string/rating_change"
                    android:minWidth="0dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/rating_unknown"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space android:layout_width="9dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/like_button"
                    android:layout_width="@dimen/secondary_button_size"
                    android:layout_height="@dimen/secondary_button_size"
                    android:background="@drawable/control_button_background"
                    android:contentDescription="@string/like"
                    android:padding="13dp"
                    android:src="@drawable/ic_thumb_up"
                    android:tint="@color/control_icon" />

                <Space android:layout_width="9dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/shuffle_button"
                    android:layout_width="@dimen/secondary_button_size"
                    android:layout_height="@dimen/secondary_button_size"
                    android:background="@drawable/control_button_background"
                    android:contentDescription="@string/shuffle_enable"
                    android:padding="13dp"
                    android:src="@drawable/ic_shuffle"
                    android:tint="@color/control_icon" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/forget_pairing_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/action_button_background"
            android:minHeight="48dp"
            android:text="@string/forget_pairing"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
