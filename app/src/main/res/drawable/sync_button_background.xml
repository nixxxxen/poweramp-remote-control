<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dark" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <padding android:left="18dp" android:top="11dp" android:right="18dp" android:bottom="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <padding android:left="18dp" android:top="11dp" android:right="18dp" android:bottom="11dp" />
        </shape>
    </item>
</selector>

