<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="18dp"
        android:paddingRight="@dimen/screen_padding"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/api_caption"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/status_background"
            android:text="@string/status_checking"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/album_art_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/album_art_height"
            android:layout_marginTop="18dp"
            android:background="@drawable/album_art_background">

            <ImageView
                android:id="@+id/album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/album_art_description"
                android:padding="86dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_album_placeholder" />
        </FrameLayout>

        <TextView
            android:id="@+id/track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/waiting_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/waiting_artist"
            android:textColor="@color/accent"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/track_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/waiting_album"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/track_audio_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/track_source_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/track_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="22dp"
            android:indeterminate="false"
            android:max="1"
            android:progress="0"
            android:progressBackgroundTint="@color/surface_high"
            android:progressTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/elapsed_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/elapsed_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/duration_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/duration_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transport_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previous_button"
                android:layout_width="@dimen/transport_button_size"
                android:layout_height="@dimen/transport_button_size"
                android:layout_marginEnd="@dimen/transport_button_gap"
                android:background="@drawable/transport_button_background"
                android:contentDescription="@string/previous_track"
                android:enabled="false"
                android:padding="16dp"
                android:scaleType="center"
                android:src="@drawable/ic_previous"
                android:tint="@color/transport_icon_tint" />

            <ImageButton
                android:id="@+id/play_pause_button"
                android:layout_width="@dimen/transport_primary_button_size"
                android:layout_height="@dimen/transport_primary_button_size"
                android:layout_marginEnd="@dimen/transport_button_gap"
                android:background="@drawable/transport_primary_button_background"
                android:contentDescription="@string/play"
                android:enabled="false"
                android:padding="17dp"
                android:scaleType="center"
                android:src="@drawable/ic_play"
                android:tint="@color/transport_primary_icon_tint" />

            <ImageButton
                android:id="@+id/next_button"
                android:layout_width="@dimen/transport_button_size"
                android:layout_height="@dimen/transport_button_size"
                android:background="@drawable/transport_button_background"
                android:contentDescription="@string/next_track"
                android:enabled="false"
                android:padding="16dp"
                android:scaleType="center"
                android:src="@drawable/ic_next"
                android:tint="@color/transport_icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/secondary_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dislike_button"
                android:layout_width="@dimen/secondary_control_size"
                android:layout_height="@dimen/secondary_control_size"
                android:layout_marginEnd="@dimen/secondary_control_gap"
                android:background="@drawable/transport_button_background"
                android:contentDescription="@string/dislike"
                android:enabled="false"
                android:padding="13dp"
                android:scaleType="center"
                android:src="@drawable/ic_thumb_down"
                android:tint="@color/transport_icon_tint" />

            <Button
                android:id="@+id/rating_button"
                android:layout_width="@dimen/rating_chip_width"
                android:layout_height="@dimen/secondary_control_size"
                android:layout_marginEnd="@dimen/secondary_control_gap"
                android:background="@drawable/secondary_chip_background"
                android:contentDescription="@string/rating_change"
                android:enabled="false"
                android:minWidth="0dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/rating_unknown"
                android:textAllCaps="false"
                android:textColor="@color/secondary_chip_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/like_button"
                android:layout_width="@dimen/secondary_control_size"
                android:layout_height="@dimen/secondary_control_size"
                android:layout_marginEnd="@dimen/secondary_control_gap"
                android:background="@drawable/transport_button_background"
                android:contentDescription="@string/like"
                android:enabled="false"
                android:padding="13dp"
                android:scaleType="center"
                android:src="@drawable/ic_thumb_up"
                android:tint="@color/transport_icon_tint" />

            <ImageButton
                android:id="@+id/shuffle_button"
                android:layout_width="@dimen/secondary_control_size"
                android:layout_height="@dimen/secondary_control_size"
                android:background="@drawable/transport_button_background"
                android:contentDescription="@string/shuffle_enable"
                android:enabled="false"
                android:padding="13dp"
                android:scaleType="center"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/transport_icon_tint" />
        </LinearLayout>

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:layout_marginTop="12dp"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/sync_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/sync_button_background"
            android:minHeight="48dp"
            android:text="@string/sync"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/server_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/api_panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/server_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/server_status_stopped"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/server_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/server_clients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/library_access_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/library_access_checking"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/request_library_permission_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sync_button_background"
                android:minHeight="48dp"
                android:text="@string/library_access_request_permission"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/server_pairing_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/server_pairing_instruction"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/server_pairing_qr"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/pairing_qr_background"
                android:contentDescription="@string/server_pairing_qr_description"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/server_pairing_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/server_pairing_unavailable"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/refresh_pairing_qr_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/sync_button_background"
                android:minHeight="48dp"
                android:text="@string/server_pairing_refresh"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/server_web_access_instruction"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/copy_web_token_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sync_button_background"
                android:minHeight="48dp"
                android:text="@string/server_copy_web_token"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
